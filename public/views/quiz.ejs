<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rosewood restore: Quiz</title>
    <link rel="stylesheet" href="../styles/main.css">
    <link rel="stylesheet" href="../styles/quiz.css">
    <script src="../scripts/quiz.js" defer></script>
</head>
<body>
    <%- include('partials/navbar') %>
<section id="quizHero">
    <h1 id="mainTitle">Local Quiz</h1>
    
    <form id="quizForm">
        
        <% for (let qKey in questions) { %>
            <div class="questionContainer" data-question-id="<%= qKey %>" data-correct="<%= answers[qKey]['correct'] %>">

                <h1><%= questions[qKey] %></h1>
    
                <div class="optionsContainer">
                    <% for (let aKey in answers[qKey]) { %>
                        <% if (aKey !== 'correct') { %>
                            <div class="radioWrapper">
                                <label class="optionLabel">
                                    <input type="radio" name="<%= qKey %>" value="<%= aKey %>" class="radioOption" required>
                                    <%= answers[qKey][aKey] %>
                                </label>
                            </div>
                        <% } %>
                    <% } %>
                </div>
            </div>
        <% } %>

        <button type="submit" class="submitBtn">Submit Answers</button>
    </form>
</section>

    <%- include('partials/footer')%>
</body>
</html>